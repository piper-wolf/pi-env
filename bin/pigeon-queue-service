#!/usr/bin/env bash
set -euo pipefail
[[ $EUID == 0 ]] || { echo 'Run with sudo.' >&2; exit 1; }
repo=/home/piper/repos/pi-env
disabled=/var/lib/pi-env/pigeon-queue.disabled
case "${1:-status}" in
  down)
    mkdir -p /var/lib/pi-env
    touch "$disabled"
    rm -f /etc/cron.d/pigeon-queue
    systemctl disable --now pigeon-queue.timer pigeon-queue-refresh.timer 2>/dev/null || true
    # Wait for an in-flight import to finish; do not interrupt a Git transaction.
    for unit in pigeon-queue.service pigeon-queue-refresh.service; do
      while [[ $(systemctl show "$unit" -p ActiveState --value) =~ ^(activating|active|deactivating)$ && $(systemctl show "$unit" -p SubState --value) != auto-restart ]]; do sleep 1; done
      systemctl stop "$unit"
    done
    echo 'Daily publishing is down. Repositories and history are preserved.' ;;
  provision|recreate)
    if [[ $1 == recreate ]]; then rm -f "$disabled"; fi
    for unit in pigeon-queue.service pigeon-queue.timer pigeon-queue-refresh.service pigeon-queue-refresh.timer; do
      install -m 0644 "$repo/systemd/$unit" "/etc/systemd/system/$unit"
    done
    rm -f /etc/cron.d/pigeon-queue
    systemctl daemon-reload
    [[ ! -e $disabled ]] || { systemctl disable --now pigeon-queue.timer pigeon-queue-refresh.timer; echo 'Pigeon queue is deliberately down; service configuration updated.'; exit 0; }
    systemctl enable --now pigeon-queue.timer pigeon-queue-refresh.timer
    echo 'Daily publishing scheduled for 10am America/Los_Angeles.' ;;
  status)
    if [[ -e $disabled ]]; then echo 'Daily publishing: down'; else echo 'Daily publishing: scheduled at 10am Pacific'; fi
    systemctl list-timers pigeon-queue.timer pigeon-queue-refresh.timer --no-pager
    systemctl show pigeon-queue.service -p ActiveState -p Result -p ExecMainStartTimestamp -p ExecMainStatus
    journalctl -u pigeon-queue.service -n 15 --no-pager ;;
  *) echo 'Usage: pigeon-queue-service {status|down|recreate|provision}' >&2; exit 1 ;;
esac
