#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

config=/etc/ssh/sshd_config.d/zz-pi-env-password-auth.conf
tmp_config=''

cleanup() {
  if [[ -n "$tmp_config" ]]; then
    rm -f -- "$tmp_config"
  fi
}
trap cleanup EXIT

usage() {
  cat <<'EOF'
Usage: sudo pi-ssh-password-auth enable [--password-stdin]
       sudo pi-ssh-password-auth disable

enable sets or replaces piper's login password and enables password
authentication for piper in the normal OpenSSH daemon. With --password-stdin,
the password is read as one line from standard input; otherwise passwd prompts
on the terminal.

disable locks piper's password and disables password authentication for piper.
Public-key authentication remains enabled in both modes.
EOF
}

die() {
  printf 'pi-ssh-password-auth: %s\n' "$*" >&2
  exit 1
}

[[ $EUID -eq 0 ]] || die 'run as root, usually with sudo'
command -v passwd >/dev/null || die 'passwd is required'
command -v sshd >/dev/null || die 'sshd is required'
command -v systemctl >/dev/null || die 'systemctl is required'

write_config() {
  local password_auth=$1
  tmp_config=$(mktemp "${config}.XXXXXX")
  cat >"$tmp_config" <<EOF
# Managed by pi-env. The global SSH policy remains public-key-only; this
# per-user Match block is enabled only during password-based key enrollment.
Match User piper
    PasswordAuthentication $password_auth
    KbdInteractiveAuthentication no
EOF
  chmod 0644 "$tmp_config"
  mv -f -- "$tmp_config" "$config"
  tmp_config=''
}

set_password_from_stdin() {
  local password=''
  if ! IFS= read -r password; then
    [[ -n "$password" ]] || die 'password input is empty'
  fi
  if IFS= read -r; then
    die 'password input must contain exactly one line'
  fi
  [[ -n "$password" ]] || die 'password input is empty'
  printf 'piper:%s\n' "$password" | chpasswd
}

enable() {
  local password_stdin=0
  if (($#)); then
    [[ "$1" == --password-stdin && $# -eq 1 ]] || { usage >&2; exit 2; }
    password_stdin=1
  fi

  if (( password_stdin )); then
    command -v chpasswd >/dev/null || die 'chpasswd is required'
    set_password_from_stdin
  else
    passwd piper
  fi

  # passwd may preserve the existing lock marker when changing a locked
  # account as root. Remove it only after a password was set successfully.
  if [[ "$(passwd -S piper | awk '{print $2}')" == L ]]; then
    passwd -u piper
  fi

  write_config yes
  if ! sshd -t; then
    write_config no
    passwd -l piper
    die 'sshd configuration validation failed; password login was disabled'
  fi
  systemctl reload ssh
  printf '%s\n' 'Password authentication enabled for piper.'
  printf '%s\n' 'Use ssh-copy-id to add a new public key, then disable this when finished.'
}

disable() {
  passwd -l piper
  write_config no
  sshd -t
  systemctl reload ssh
  printf '%s\n' 'Password authentication disabled for piper; public-key login remains enabled.'
}

[[ $# -ge 1 ]] || { usage >&2; exit 2; }
case "$1" in
  enable) shift; enable "$@" ;;
  disable) shift; (($# == 0)) || { usage >&2; exit 2; }; disable ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
