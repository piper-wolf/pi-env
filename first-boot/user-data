#cloud-config
hostname: piper-pi
manage_etc_hosts: true
timezone: America/Los_Angeles
ssh_pwauth: false
disable_root: true
enable_ssh: true
users:
  - name: piper
    gecos: Piper Wolf
    groups: [adm, sudo, audio, video, plugdev, netdev, gpio, i2c, spi]
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - __PI_ENV_SSH_KEY_INJECTED_BY_PREPARE_CARD__
package_update: true
package_upgrade: false
apt_retries: 10
apt_retry_interval: 15
packages:
  - ca-certificates
  - curl
  - git
  - openssh-server
  - avahi-daemon
  - libnss-mdns
write_files:
  - path: /etc/ssh/sshd_config.d/99-pi-env.conf
    permissions: '0644'
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
  - path: /etc/systemd/system/pi-env-bootstrap.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Initial piper-pi provisioning
      Wants=network-online.target
      After=network-online.target
      StartLimitIntervalSec=0

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      TimeoutStartSec=0
      StandardOutput=journal+console
      StandardError=journal+console
      ExecStart=/opt/pi-env/first-boot/bootstrap.sh
      Restart=on-failure
      RestartSec=30s

      [Install]
      WantedBy=multi-user.target
runcmd:
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, ssh]
  - [systemctl, enable, --now, pi-env-bootstrap.service]

final_message: "pi-env cloud-init finished; inspect /boot/firmware/pi-env-status if remote access is unavailable."
